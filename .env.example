# Copy this file to .env and fill in real values. Never commit .env.
ANTHROPIC_API_KEY=
PORT=

# Bank details shared with customers after they confirm an order
BANK_ACCOUNT_NAME=
BANK_NAME=
BANK_ACCOUNT_NUMBER=
BANK_IBAN=

# Email (Gmail). SMTP_PASS is a Gmail App Password (Google Account > Security > App passwords),
# never your normal Gmail password. Leave SMTP_PASS empty to turn emails off.
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
OWNER_EMAIL=

# Owner dashboard login at /owner. Supports multiple owner logins (OWNER_..., OWNER2_...).
# Set primary with: cd backend && npm run set-owner-password
OWNER_USERNAME=
OWNER_PASSWORD_HASH=
OWNER2_USERNAME=
OWNER2_PASSWORD_HASH=
SITE_URL=

# Optional: where orders and receipts are saved (default: the data folder)
DATA_DIR=
